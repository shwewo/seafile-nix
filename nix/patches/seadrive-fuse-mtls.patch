+/* Per-host mutual-TLS client certificate. */
+typedef struct ClientCert {
+    char *cert_path;
+    char *key_path;
+    char *cert_type;    /* "PEM" or "P12" */
+    char *password;
+} ClientCert;
+
+static void
+client_cert_free (void *data)
+{
+    ClientCert *c = data;
+    if (!c)
+        return;
+    g_free (c->cert_path);
+    g_free (c->key_path);
+    g_free (c->cert_type);
+    g_free (c->password);
+    g_free (c);
+}
+
 struct _HttpTxPriv {
