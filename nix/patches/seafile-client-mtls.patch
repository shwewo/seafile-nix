+    mtls_password_label_ = new QLabel(tr("Password:"));
+    mtls_password_label_->setAlignment(Qt::AlignRight | Qt::AlignVCenter);
+    mtls_password_ = new QLineEdit;
+    mtls_password_->setEchoMode(QLineEdit::Password);
