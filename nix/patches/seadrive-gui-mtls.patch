+    QLineEdit *edit = new QLineEdit;
+    edit->setPlaceholderText(placeholder);
+    QPushButton *btn = new QPushButton(LoginDialog::tr("Browse..."));
+    layout->addWidget(edit);
+    layout->addWidget(btn);
+    *edit_out = edit;
+    *btn_out = btn;
+    return row;
