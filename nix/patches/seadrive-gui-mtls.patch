+void AccountManager::applyMtlsSslConfig(const Account& account)
+{
+    if (!account.hasClientSslCert())
+        return;
+
+    QSslConfiguration sslConfig = QSslConfiguration::defaultConfiguration();
+    QString certPath = account.clientSslCertPath;
+    QString certType = account.clientSslCertType;
+    QByteArray password = account.clientSslCertPassword.toUtf8();
+    QString keyPath  = account.clientSslKeyPath;
+
+    if (certType.compare("P12", Qt::CaseInsensitive) == 0) {
+        QFile f(certPath);
+        if (!f.open(QIODevice::ReadOnly)) {
+            qWarning("[mtls] cannot open P12 file: %s", qPrintable(certPath));
+            return;
+        }
+        QSslKey key;
+        QSslCertificate cert;
+        if (QSslCertificate::importPkcs12(&f, &key, &cert, nullptr, password)) {
+            sslConfig.setLocalCertificate(cert);
+            sslConfig.setPrivateKey(key);
+        } else {
+            qWarning("[mtls] failed to import P12: %s", qPrintable(certPath));
+            return;
+        }
+    } else {
+        QList<QSslCertificate> certs = QSslCertificate::fromPath(certPath, QSsl::Pem);
+        if (certs.isEmpty()) {
+            qWarning("[mtls] no cert loaded from: %s", qPrintable(certPath));
+            return;
+        }
+        sslConfig.setLocalCertificate(certs.first());
+
+        QString actualKeyPath = keyPath.isEmpty() ? certPath : keyPath;
+        QFile keyFile(actualKeyPath);
+        if (keyFile.open(QIODevice::ReadOnly)) {
+            QByteArray keyData = keyFile.readAll();
+            QSslKey key(keyData, QSsl::Rsa, QSsl::Pem, QSsl::PrivateKey, password);
+            if (key.isNull())
+                key = QSslKey(keyData, QSsl::Ec, QSsl::Pem, QSsl::PrivateKey, password);
+            if (!key.isNull())
+                sslConfig.setPrivateKey(key);
+        }
+    }
+
+    if (sslConfig.localCertificate().isNull()) {
+        qWarning("[mtls] cert loaded but is null, skipping");
+        return;
+    }
+
+    QSslConfiguration::setDefaultConfiguration(sslConfig);
+
+    // Clear cached connections so the next request performs a fresh handshake.
+    // At startup the QNAM may not exist yet; the null-check handles that case.
+    QNetworkAccessManager *nam = qApp->findChild<QNetworkAccessManager *>();
+    if (nam)
+        nam->clearConnectionCache();
+
+    qWarning("[mtls] applied startup SSL cert for %s",
+             qPrintable(account.serverUrl.host()));
+}
