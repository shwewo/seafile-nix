+void AccountManager::syncClientSslCerts()
+{
+    QJsonObject root;
+    QList<Account> accounts_snapshot;
+
+    {
+        QMutexLocker lock(&accounts_mutex_);
+        accounts_snapshot = accounts_;
+        for (const Account& account : accounts_snapshot) {
+            QString host = account.serverUrl.host();
+            mtls::CertConfig cfg;
+            cfg.certPath = account.clientSslCertPath;
+            cfg.keyPath = account.clientSslKeyPath;
+            cfg.certType = account.clientSslCertType.isEmpty()
+                               ? QString("PEM") : account.clientSslCertType;
+            cfg.password = account.clientSslCertPassword;
+
+            mtls::setHostCert(host, cfg);
+
+            if (!cfg.isEmpty()) {
+                QJsonObject entry;
+                entry["cert_path"] = cfg.certPath;
+                entry["key_path"] = cfg.keyPath;
+                entry["cert_type"] = cfg.certType;
+                entry["cert_password"] = cfg.password;
+                root[host.toLower()] = entry;
+            }
+        }
+    }
+
+#ifdef Q_OS_MAC
+    // Each File Provider domain has its own data dir on macOS.
+    for (const Account& account : accounts_snapshot) {
+        if (!account.hasClientSslCert())
+            continue;
+        QString host = account.serverUrl.host().toLower();
+        if (!root.contains(host))
+            continue;
+        QString domainDir = QDir(QDir(seadriveWorkDir()).filePath(seadriveInternalDir()))
+                                .filePath(account.domainID());
+        QDir().mkpath(domainDir);
+        QString path = QDir(domainDir).filePath(kClientSslCertsFile);
+        QJsonObject one;
+        one[host] = root[host];
+        QFile f(path);
+        if (f.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+            f.write(QJsonDocument(one).toJson(QJsonDocument::Compact));
+            f.close();
+            f.setPermissions(QFile::ReadOwner | QFile::WriteOwner);
+        } else {
+            qWarning("[mtls] failed to write %s", qPrintable(path));
+        }
+    }
+#else
+    QString dataDir = QDir(seadriveWorkDir()).absoluteFilePath(seadriveDataDir());
+    QDir().mkpath(dataDir);
+    QString path = QDir(dataDir).filePath(kClientSslCertsFile);
+    QFile f(path);
+    if (f.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        f.write(QJsonDocument(root).toJson(QJsonDocument::Compact));
+        f.close();
+        f.setPermissions(QFile::ReadOwner | QFile::WriteOwner);
+    } else {
+        qWarning("[mtls] failed to write %s", qPrintable(path));
+    }
+#endif
+}
